#version 450
// How far the picture has moved since the frame the model's answer belongs to.
//
// The pipelined path lays an edit computed on an earlier frame onto the current one. The edit is
// therefore in the wrong place by however much the picture moved in between -- measured at about
// 17 ms, which during an ordinary turn is on the order of a hundred pixels. That displacement is the
// ghost, and no threshold removes it, because the edit is not doubtful, it is misplaced.
//
// The helper's optical flow was meant to correct this and cannot, for a reason that is structural
// rather than a matter of tuning: the helper only receives one frame per round trip, so its field
// describes the interval *before* the answer's frame rather than the interval since. It is the right
// length and the wrong window.
//
// The layer has both endpoints of the right window sitting in memory already. _proxySent is the
// picture the answer was computed from; _proxy is this frame. The displacement between those two is
// exactly what the composition needs, and estimating it as a single global translation fits two
// parameters to thousands of samples -- hugely overdetermined, and so far more robust than a dense
// per-pixel field over the same large displacement.
//
// Global translation captures camera yaw and pitch, which is the motion that produces the artifact:
// over a small angle a rotation moves the whole picture by very nearly a constant, and unlike
// translation of the camera it does so independently of depth -- which matters because this layer
// only ever sees the finished frame and has no depth buffer to consult.
//
// Three entry points, selected at compile time, so the pipeline stays three small dispatches whose
// cost does not grow with the frame: the working images are a fixed size whatever the display is.

// 256 lanes. The match pass is the expensive one and it reduces over the whole working image, so the
// wider the workgroup the fewer passes each lane makes over it. The reduce and pick passes do not
// care -- reduce is dispatched over its own output and pick is a single lane -- so one size serves.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#if defined(PASS_REDUCE)
// Full-resolution proxy -> a small luma image. Bilinear, so the reduction is an average rather than a
// sample, which is what keeps a one-pixel-per-frame motion visible after the shrink.
layout(binding = 0) uniform Params { uvec2 dstSize; uvec2 pad; } pc;
layout(binding = 1) uniform sampler2D uSrc;
layout(r32f, binding = 2) uniform writeonly image2D uDst;

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    if (id.x >= int(pc.dstSize.x) || id.y >= int(pc.dstSize.y)) return;
    vec2 uv = (vec2(id) + 0.5) / vec2(pc.dstSize);
    vec3 c = texture(uSrc, uv).rgb;
    imageStore(uDst, id, vec4(dot(c, vec3(0.2126, 0.7152, 0.0722)), 0, 0, 1));
}

#elif defined(PASS_MATCH)
// One workgroup per candidate offset; each reduces the absolute difference over the whole small
// image. Brute force on purpose: the search is a few hundred candidates over a few thousand pixels,
// which is nothing, and it has no local minimum to get trapped in the way an iterative solver does.
layout(binding = 0) uniform Params {
    uvec2 size; int radius; int useBase;
    float cellX; float cellY; int pad0; int pad1;
} pc;
layout(r32f, binding = 1) uniform readonly image2D uNow;
layout(r32f, binding = 2) uniform readonly image2D uThen;
layout(std430, binding = 3) buffer Cost { float cost[]; };
// The coarse level's answer, when this is the fine level. Searching a small window around it costs a
// fraction of widening the coarse search, and buys the accuracy that matters: at the coarse scale one
// cell is several pixels of the real frame, and a residual of a couple of pixels is enough to
// decorrelate fine detail completely -- which is most of what the model was asked to enhance.
layout(rgba32f, binding = 4) uniform readonly image2D uBase;

shared float sPartial[256];

void main() {
    const int span = 2 * pc.radius + 1;
    const int slot = int(gl_WorkGroupID.x);
    ivec2 base = ivec2(0);
    if (pc.useBase != 0) {
        vec2 b = imageLoad(uBase, ivec2(0)).xy;
        base = ivec2(round(b / vec2(pc.cellX, pc.cellY)));
    }
    const ivec2 off = base + ivec2(slot % span, slot / span) - ivec2(pc.radius);
    const uint lane = gl_LocalInvocationIndex;

    float sum = 0.0;
    float n = 0.0;
    // Strided so every lane walks the whole image rather than a block of it: a block-per-lane split
    // makes each lane's partial depend on what happens to be in its corner of the picture.
    for (uint i = lane; i < pc.size.x * pc.size.y; i += 256u) {
        ivec2 p = ivec2(int(i % pc.size.x), int(i / pc.size.x));
        ivec2 q = p + off;
        if (q.x < 0 || q.y < 0 || q.x >= int(pc.size.x) || q.y >= int(pc.size.y)) continue;
        sum += abs(imageLoad(uNow, p).r - imageLoad(uThen, q).r);
        n += 1.0;
    }
    sPartial[lane] = n > 0.0 ? sum / n : 1e9;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1) {
        if (lane < s) sPartial[lane] = min(sPartial[lane], sPartial[lane + s]);
        barrier();
    }
    // Averaged rather than summed, so an offset that pushes most of the image off the edge is not
    // rewarded for comparing fewer pixels.
    if (lane == 0u) cost[slot] = sPartial[0];
}

#elif defined(PASS_PICK)
// The lowest cost, refined to sub-pixel by a parabola through its two neighbours, written out in
// pixels of the full frame. A single workgroup: there are only a few hundred candidates.
layout(binding = 0) uniform Params {
    int radius; float scaleX; float scaleY; int useBase;
    // Which frame this estimate belongs to, carried out with it so a reading taken later can say how
    // old it is instead of being assumed fresh.
    uint frameNo; uint pad0; uint pad1; uint pad2;
} pc;
layout(std430, binding = 1) readonly buffer Cost { float cost[]; };
layout(rgba32f, binding = 3) uniform readonly image2D uBase;
// The tracker's memory: xy is how fast the displacement was growing, z says whether it holds anything.
// A one-by-one image rather than a buffer, on purpose. The composition already samples a motion
// field; a field that is a single texel returns the same vector at every pixel, which is precisely a
// global translation -- so this drops into the existing shader without touching a single binding.
layout(rgba32f, binding = 2) uniform image2D uResult;

float At(int x, int y, int span) {
    x = clamp(x, 0, span - 1);
    y = clamp(y, 0, span - 1);
    return cost[y * span + x];
}

void main() {
    if (gl_LocalInvocationIndex != 0u) return;
    const int span = 2 * pc.radius + 1;

    int best = 0;
    float bestCost = 1e30;
    float worst = 0.0;
    float mean = 0.0;
    for (int i = 0; i < span * span; ++i) {
        float c = cost[i];
        mean += c;
        worst = max(worst, c);
        if (c < bestCost) { bestCost = c; best = i; }
    }
    mean /= float(span * span);

    int bx = best % span, by = best / span;
    // Parabolic refinement, so the estimate is not quantised to whole cells of the small image --
    // which at this scale is several pixels of the real frame.
    float cx0 = At(bx - 1, by, span), cx2 = At(bx + 1, by, span);
    float cy0 = At(bx, by - 1, span), cy2 = At(bx, by + 1, span);

    // Refine only where the minimum has a real shape to refine.
    //
    // The denominator here is the curvature of the cost surface, and dividing by it when it is nearly
    // zero is what put a tremble on a completely still camera. Two frames of a motionless scene are
    // not identical in any real game -- dithering, grain, a jittered sample pattern -- so the surface
    // is flat with a little noise on it, the curvature is nothing, the old floor of 1e-6 let the
    // quotient run away, and the clamp handed back a whole cell of displacement whose sign was picked
    // by the noise. Four pixels at the fine level, eight at the coarse, different every frame, on a
    // camera that was not moving.
    //
    // So the curvature has to be a real fraction of the cost before it is believed, and the offset is
    // held to half a cell either way -- which is all a parabola through three samples can honestly
    // say, since past that the true minimum belongs to the neighbouring sample instead.
    const float kCurve = 1e-4 + 0.02 * mean;
    const float curveX = cx0 - 2.0 * bestCost + cx2;
    const float curveY = cy0 - 2.0 * bestCost + cy2;
    float dx = curveX > kCurve ? clamp((cx0 - cx2) / (2.0 * curveX), -0.5, 0.5) : 0.0;
    float dy = curveY > kCurve ? clamp((cy0 - cy2) / (2.0 * curveY), -0.5, 0.5) : 0.0;

    // How much better the winner is than the field it won against. A picture with real structure
    // gives a sharp minimum; a flat wall, a fade, or a scene that simply changed gives a shallow one,
    // and a displacement read off a shallow minimum is a guess. The composition fades the edit out
    // where this is low rather than warping by a number nobody should trust.
    float confidence = clamp((mean - bestCost) / max(mean, 1e-6), 0.0, 1.0);

    // A winner sitting on the edge of the window is not a winner, it is the search running out of
    // room: the true displacement is somewhere further out and this is the closest the search could
    // get to it. Observed directly -- a pan whose displacement is a clean 2:1 in x and y reported
    // ratios of 1.5 whenever the magnitude reached the edge of the range. Saying so costs nothing and
    // lets the composition fade rather than warp by a number that is known to be short.
    // Only at the coarse level. There, the window is the whole range the search can see, so its edge
    // really does mean "further out than I can look". At the fine level the window is three cells
    // either side of the coarse answer, and landing on its edge means only that the coarse answer was
    // slightly off -- which is what the fine level is for. Penalising that was measured taking a
    // sixth of the agreement away for nothing.
    // A clipped match is short, not meaningless. The window edge means the true displacement is
    // further out, so the vector understates it -- but it still points the right way, and warping by
    // a vector that is too short beats not warping at all. This used to multiply by 0.15, which after
    // the composition's knee came to exactly zero: any movement fast enough to leave the search range
    // switched the whole effect off and showed the game's raw frame. Reducing trust is the point;
    // annihilating it was a bug.
    if (pc.useBase == 0 && (bx == 0 || by == 0 || bx == span - 1 || by == span - 1)) confidence *= 0.55;

    // The coarse displacement is quantised to this level's cell, which is exactly what the fine
    // search was centred on, so it is added back in whole rather than re-derived.
    vec2 base = vec2(0.0);
    if (pc.useBase != 0) {
        vec2 b = imageLoad(uBase, ivec2(0)).xy;
        base = round(b / vec2(pc.scaleX, pc.scaleY)) * vec2(pc.scaleX, pc.scaleY);
    }
    vec2 measured = vec2(base.x + (float(bx - pc.radius) + dx) * pc.scaleX,
                        base.y + (float(by - pc.radius) + dy) * pc.scaleY);

    // No temporal smoothing here. It was tried twice and lost twice: a constant-velocity filter with
    // the gains used is underdamped -- complex eigenvalues of magnitude 0.74 -- so every disturbance
    // decays as an oscillation rather than settling, which is a tremble by construction. Smoothing is
    // the wrong answer to a measurement that jumps; not jumping is the right one, and that is what the
    // conditioning above and the gradient solve afterwards are for.
    imageStore(uResult, ivec2(0, 0), vec4(measured, confidence, float(pc.frameNo)));
}
#elif defined(PASS_LK)
// Gradient refinement of the residual, which is what makes the estimate smooth.
//
// A discrete search is integer-resolution by construction: it can only name a cell. At the finest
// level here a cell is eight pixels of a 2560-wide frame, so even a perfect half-cell parabola leaves
// the answer quantised to about four pixels -- and four pixels of the whole picture, jumping a
// different way each frame, is exactly the trembling that was reported. No amount of tuning the
// search removes it, because the search does not have the resolution to remove.
//
// So the search is used for what it is good at -- finding the right basin over a large range, robustly
// -- and the last fraction of a pixel is solved for instead. Linearising the picture about the
// current estimate gives a two-by-two system in the residual shift:
//
//     [ SIGMA Ix*Ix  SIGMA Ix*Iy ] [du]     [ SIGMA Ix*e ]
//     [ SIGMA Ix*Iy  SIGMA Iy*Iy ] [dv]  =  [ SIGMA Iy*e ]
//
// with e the difference between the two pictures at the current estimate. Six sums and one solve for
// the whole frame, which is why this costs nothing: it is a global model, so every pixel contributes
// to the same two numbers. This is the standard pairing -- a coarse search for range, gradients for
// precision -- and it is used because neither half works alone.
layout(binding = 0) uniform Params {
    uvec2 size; float cellX; float cellY;
    float maxStep; int pad0; int pad1; int pad2;
} pc;
layout(binding = 1) uniform sampler2D uNowS;
layout(binding = 2) uniform sampler2D uThenS;
layout(rgba32f, binding = 3) uniform image2D uResult;

shared float sAcc[64][5];

void main() {
    const uint lane = gl_LocalInvocationIndex;
    vec2 est = imageLoad(uResult, ivec2(0, 0)).xy;
    // The estimate is in pixels of the frame; here it is wanted in cells of this working image.
    const vec2 offCells = est / vec2(pc.cellX, pc.cellY);

    float a = 0.0, b = 0.0, c = 0.0, d = 0.0, e2 = 0.0;
    for (uint i = lane; i < pc.size.x * pc.size.y; i += 64u) {
        ivec2 p = ivec2(int(i % pc.size.x), int(i / pc.size.x));
        // Skip the border, where a gradient would reach outside the picture.
        if (p.x < 2 || p.y < 2 || p.x >= int(pc.size.x) - 2 || p.y >= int(pc.size.y) - 2) continue;
        vec2 uv = (vec2(p) + 0.5) / vec2(pc.size);
        float n = texture(uNowS, uv).r;
        vec2 tuv = (vec2(p) + offCells + 0.5) / vec2(pc.size);
        if (any(lessThan(tuv, vec2(0.0))) || any(greaterThan(tuv, vec2(1.0)))) continue;
        float t = texture(uThenS, tuv).r;
        float ix = 0.5 * (texture(uNowS, uv + vec2(1.0 / float(pc.size.x), 0.0)).r -
                          texture(uNowS, uv - vec2(1.0 / float(pc.size.x), 0.0)).r);
        float iy = 0.5 * (texture(uNowS, uv + vec2(0.0, 1.0 / float(pc.size.y))).r -
                          texture(uNowS, uv - vec2(0.0, 1.0 / float(pc.size.y))).r);
        float err = t - n;
        a += ix * ix; b += ix * iy; c += iy * iy;
        d += ix * err; e2 += iy * err;
    }
    sAcc[lane][0] = a; sAcc[lane][1] = b; sAcc[lane][2] = c; sAcc[lane][3] = d; sAcc[lane][4] = e2;
    barrier();
    for (uint s = 32u; s > 0u; s >>= 1) {
        if (lane < s)
            for (int k = 0; k < 5; ++k) sAcc[lane][k] += sAcc[lane + s][k];
        barrier();
    }
    if (lane != 0u) return;

    a = sAcc[0][0]; b = sAcc[0][1]; c = sAcc[0][2]; d = sAcc[0][3]; e2 = sAcc[0][4];
    float det = a * c - b * b;
    // A picture with no gradient in some direction cannot say how far it moved in that direction, and
    // the solve would answer anyway. Refuse instead and keep what the search found.
    //
    // The condition has to be relative to how much gradient there actually is, not an absolute floor.
    // A frame of nearly flat wall with a little noise on it produces a small but non-zero Hessian, an
    // absolute test passes it, and the solve then answers from the noise -- a different answer every
    // frame, which is the trembling this pass exists to remove rather than to cause.
    const float scale = max(a + c, 1e-12);
    if (det > 0.02 * scale * scale) {
        vec2 step = -vec2(c * d - b * e2, a * e2 - b * d) / det;
        // In cells here; a refinement larger than the search's own resolution is not a refinement.
        if (all(lessThan(abs(step), vec2(pc.maxStep))) && !any(isnan(step)))
            imageStore(uResult, ivec2(0, 0),
                       vec4(est + step * vec2(pc.cellX, pc.cellY),
                            imageLoad(uResult, ivec2(0, 0)).zw));
    }
}
#endif
